<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Log Data</title>
  <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.11.2/css/jquery.dataTables.min.css">
  <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/responsive/2.2.9/css/responsive.dataTables.min.css">
</head>
<body>
<table id="logData" class="display responsive nowrap" style="width:100%">
  <thead>
  <tr>
    <th>Level</th>
    <th>Time</th>
    <th>HostName</th>
    <th>Context</th>
    <th>Message</th>
    <th>Correlation ID</th>
    <th>Request</th>
    <th>Query</th>
    <th>Body</th>
    <th>Error</th>
  </tr>
  </thead>
  <tbody>
  {{#each logData}}
    <tr>
      <td>{{this.level}}</td>
      <td>{{this.time}}</td>
      <td>{{this.hostname}}</td>
      <td>{{this.context}}</td>
      <td>{{this.msg}}</td>
      <td>{{this.correlationId}}</td>
      <td>
        <button type="button" data-req="{{json this.req}}" data-id="{{this.correlationId}}" {{#unless this.req}} disabled {{/unless}}>
          View Request
        </button>
      </td>
      <td>
        <button type="button" data-query="{{json this.query}}" data-id="{{this.correlationId}}" {{#unless this.query}} disabled {{/unless}}>
          View Query
        </button>
      </td>
      <td>
        <button type="button" data-body="{{json this.body}}" data-id="{{this.correlationId}}" {{#unless this.body}} disabled {{/unless}}>
          View Body
        </button>
      </td>
      <td>
        <button type="button" data-err="{{json this.err}}" data-id="{{this.correlationId}}" {{#unless this.err}} disabled {{/unless}}>
          View Error
        </button>
      </td>
    </tr>
  {{/each}}
  </tbody>
</table>

<div id="dataJSON" tabindex="-1" style="display: none;">
    <h5 id="requestJSONLabel"><span id="typeData"></span> Details | <span id="correlationId"></span></h5>
    <pre id="renderDataJSON"></pre>
</div>
</body>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.11.2/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/responsive/2.2.9/js/dataTables.responsive.min.js"></script>
<script>
  $(document).ready(function() {
    const table = $('#logData').DataTable()

    const renderData = function (id, data) {
      if(id)
      {
        $("#dataJSON").show()

        $('#correlationId').text(id);
        $('#renderDataJSON').text(JSON.stringify(data, null, 2));
      }
    }

    table.on('click', 'button[data-req]', function() {
      const id = $(this).data('id');
      const data = $(this).data('req');
      $('#typeData').text('Request')
      renderData(id, data);
    });

    table.on('click', 'button[data-query]', function() {
      const id = $(this).data('id');
      const data = $(this).data('query');
      $('#typeData').text('Query')
      renderData(id, data);
    });

    table.on('click', 'button[data-body]', function() {
      const id = $(this).data('id');
      const data = $(this).data('body');
      $('#typeData').text('Body')
      renderData(id, data);
    });

    table.on('click', 'button[data-err]', function() {
      const id = $(this).data('id');
      const data = $(this).data('err');
      $('#typeData').text('Error')
      renderData(id, data);
    });
  });
</script>

</html>
